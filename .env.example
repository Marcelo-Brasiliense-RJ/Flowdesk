# FlowDesk — variaveis do docker-compose (EasyPanel). Copie para .env e preencha.
# O .env NAO deve ser versionado. Nunca comitar segredos (senha do banco, chaves).

# Segredo de assinatura do JWT. Use uma string longa e aleatoria em producao.
SECRET_KEY=change-me-to-a-long-random-string

# Senha do seed inicial. Necessaria so se o banco estiver VAZIO; com o Supabase
# ja populado, pode deixar em branco.
SEED_PASSWORD=

# Smart Chat (OpenAI). Vazio = modo simulado (deterministico).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Interpretador Python dos scripts. Deixe VAZIO no container.
SCRIPT_PYTHON=

# Origem publica do front (CORS). No EasyPanel, use o dominio real.
FRONTEND_ORIGIN=http://localhost:5173

# Banco Postgres (Supabase). Use a URL do POOLER (IPv4). Formato:
# postgresql://USUARIO:SENHA@HOST_POOLER:5432/postgres?sslmode=require
# A senha vai aqui apenas no .env local (gitignored) ou no painel do EasyPanel.
SUPABASE_DB_URL=

# true deixa os apps publicados (/app/<sub>) abertos, SEM login.
PUBLIC_APPS_OPEN=false
