# FlowDesk backend configuration
# Copy to .env and fill in real values. .env is gitignored.

# JWT signing secret (change in production)
SECRET_KEY=change-me-to-a-long-random-string

# Smart Chat AI provider (OpenAI). Leave empty to run in deterministic mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Python interpreter used to run user scripts in subprocess.
# On Windows this is usually "python"; the backend auto-detects sys.executable if empty.
SCRIPT_PYTHON=

# CORS origin for the Vite dev frontend
FRONTEND_ORIGIN=http://localhost:5173
